# Copy this file to .env.local and replace the database URL locally.
APP_ADDR=:9090
DATABASE_URL='postgresql://postgres.escntlunkvcoiylczijh:LamTest2026Db@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres'
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_API_TOKEN=lam-admin-api-token

# Optional: sends a best-effort Realtime Broadcast signal after a customer
# request is created (see internal/notify.Broadcaster). Leave both empty to
# disable sending entirely — the admin web's 60s safety-net poll still
# delivers the notification, just slower. SUPABASE_BROADCAST_KEY must be a
# server-only secret/service_role key, never the anon/publishable key.
SUPABASE_URL=
SUPABASE_BROADCAST_KEY=
