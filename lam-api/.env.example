# Copy this file to .env.local and replace the database URL locally.
APP_ADDR=:9090
DATABASE_URL='postgresql://postgres.escntlunkvcoiylczijh:LamTest2026Db@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres'
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_API_TOKEN=lam-admin-api-token

# Optional: sends a best-effort Realtime Broadcast signal after a customer
# request is created (see internal/notify.Broadcaster). Leave both empty to
# disable sending entirely — the admin web's 60s safety-net poll still
# delivers the notification, just slower. SUPABASE_BROADCAST_KEY must be a
# server-only secret/service_role key, never the anon/publishable key.
SUPABASE_URL=
SUPABASE_BROADCAST_KEY=

# Required only for approving song requests into the store player queue.
# Create a server-side YouTube Data API v3 key; never expose it to either web app.
YOUTUBE_API_KEY=

# Admin table QR page only (GET /api/v1/admin/tables).
# QR_SIGNING_SECRET must be byte-for-byte identical to lam-web's
# QR_SIGNING_SECRET. If the two differ, lam-web cannot verify the signatures
# this API prints into the QR codes, so every issued QR is invalid and each
# scan lands on /access-required. It is a server-only secret: never expose it
# to any web app as NEXT_PUBLIC_*.
# CUSTOMER_WEB_BASE_URL is the customer web origin embedded in every QR URL,
# so it must be an address the customer's phone browser can reach directly —
# never a Compose-internal DNS name such as http://lam-web:8080.
# The endpoint returns 500 while either value is empty.
QR_SIGNING_SECRET=
CUSTOMER_WEB_BASE_URL=http://localhost:3000
